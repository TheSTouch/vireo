#!/usr/bin/env bash
# Regenerates Vireo's app icons from their SVG sources:
#   crates/zed/resources/app-icon.svg          -> app-icon*.png (macOS and Linux, every channel)
#   crates/zed/resources/windows/app-icon.svg  -> windows/app-icon*.ico (every channel)
# Needs rsvg-convert (brew install librsvg) and python3.
set -euo pipefail
cd "$(dirname "$0")/.."
resources=crates/zed/resources
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

for size in 512 1024; do
    rsvg-convert -w "$size" -h "$size" "$resources/app-icon.svg" -o "$work/mac-$size.png"
done
for size in 16 24 32 48 64 128 256; do
    rsvg-convert -w "$size" -h "$size" "$resources/windows/app-icon.svg" -o "$work/win-$size.png"
done

# An ICO whose entries are PNG images, which Windows reads since Vista.
python3 -I - "$work" <<'PY'
import struct, sys
work = sys.argv[1]
sizes = [16, 24, 32, 48, 64, 128, 256]
images = [open(f"{work}/win-{size}.png", "rb").read() for size in sizes]
offset = 6 + 16 * len(sizes)
header = struct.pack("<HHH", 0, 1, len(sizes))
entries = b""
for size, data in zip(sizes, images):
    side = 0 if size == 256 else size
    entries += struct.pack("<BBBBHHII", side, side, 0, 0, 1, 32, len(data), offset)
    offset += len(data)
open(f"{work}/app-icon.ico", "wb").write(header + entries + b"".join(images))
PY

for channel in "" -preview -nightly -dev; do
    cp "$work/mac-512.png" "$resources/app-icon$channel.png"
    cp "$work/mac-1024.png" "$resources/app-icon$channel@2x.png"
    cp "$work/app-icon.ico" "$resources/windows/app-icon$channel.ico"
done
echo "App icons regenerated."
