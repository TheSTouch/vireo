    "bookmark": "bookmark",
    "case_sensitive": "case-sensitive",
    "check": "check",
    "check_double": "check-all",
    "chevron_down": "chevron-down",
    "chevron_left": "chevron-left",
    "chevron_right": "chevron-right",
    "chevron_up": "chevron-up",
    "circle_help": "question",
    "close": "close",
    "code": "code",
    "copy": "copy",
    "debug": "debug-alt",
    "debug_breakpoint": "circle-filled",
    "debug_continue": "debug-continue",
    "debug_detach": "debug-disconnect",
    "debug_disabled_breakpoint": "circle-filled",
    "debug_disabled_log_breakpoint": "debug-breakpoint-log-unverified",
    "debug_log_breakpoint": "debug-breakpoint-log",
    "debug_pause": "debug-pause",
    "debug_step_into": "debug-step-into",
    "debug_step_out": "debug-step-out",
    "debug_step_over": "debug-step-over",
    "diff": "diff",
    "download": "cloud-download",
    "ellipsis": "ellipsis",
    "envelope": "mail",
    "eye": "eye",
    "eye_off": "eye-closed",
