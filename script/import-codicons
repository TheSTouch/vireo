    "folder_open": "folder-opened",
    "git_branch": "git-branch",
    "git_commit": "git-commit",
    "git_merge_conflict": "git-merge",
    "github": "github",
    "history_rerun": "history",
    "info": "info",
    "json": "json",
    "keyboard": "record-keys",
    "link": "link",
    "list_collapse": "collapse-all",
    "list_tree": "list-tree",
    "lock": "lock",
    "magnifying_glass": "search",
    "maximize": "screen-full",
    "menu": "menu",
    "mic": "mic",
    "minimize": "screen-normal",
    "pencil": "edit",
    "person": "account",
    "pin": "pin",
    "play_outlined": "play",
    "plus": "add",
    "pull_request": "git-pull-request",
    "refresh_title": "refresh",
    "regex": "regex",
    "replace": "replace",
    "replace_all": "replace-all",
    "server": "server",
    "settings": "settings-gear",
    "sparkle": "sparkle",
    "split": "split-horizontal",
    "star": "star-empty",
    "star_filled": "star-full",
    "stop": "debug-stop",
    "terminal": "terminal",
    "trash": "trash",
    "user_group": "organization",
    "warning": "warning",
    "whole_word": "whole-word",
    "x_circle": "error",
}


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    source = Path(sys.argv[1]) / "src/icons"
    missing = []
    for zed_name, codicon in CODICONS.items():
        svg = source / f"{codicon}.svg"
        if not svg.exists():
            missing.append(codicon)
            continue
        (ICONS / f"{zed_name}.svg").write_text(svg.read_text().strip() + "\n")
    if missing:
        sys.exit(f"missing codicons: {', '.join(missing)}")
    print(f"copied {len(CODICONS)} codicons into {ICONS.relative_to(REPO)}")


if __name__ == "__main__":
    main()
