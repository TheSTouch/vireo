#!/usr/bin/env python3
"""Copy Codicons over Zed's UI icons so Vireo's chrome looks like VS Code's.

Usage: script/import-codicons <path to microsoft/vscode-codicons checkout>

Each entry maps a file in assets/icons (named after crates/icons' IconName) to
a Codicon in src/icons. Icons with no close Codicon keep Zed's Lucide artwork.
Codicons are CC BY 4.0; see assets/icons/LICENSES.
"""

import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
ICONS = REPO / "assets/icons"

CODICONS = {
    # Activity bar and layout controls. These names are new in Vireo.
    "activity_explorer": "files",
    "activity_search": "search",
    "activity_source_control": "source-control",
    "activity_run_debug": "debug-alt",
    "activity_extensions": "extensions",
    "activity_accounts": "account",
    "activity_manage": "settings-gear",
    "layout_sidebar_left": "layout-sidebar-left",
    "layout_sidebar_left_off": "layout-sidebar-left-off",
    "layout_panel": "layout-panel",
    "layout_panel_off": "layout-panel-off",
    "layout_sidebar_right": "layout-sidebar-right",
    "layout_sidebar_right_off": "layout-sidebar-right-off",
    "remote": "remote",
    "sync": "sync",
    "outline": "symbol-class",
    "timeline": "history",
    # Zed's existing icons.
    "arrow_down": "arrow-down",
    "arrow_left": "arrow-left",
    "arrow_right": "arrow-right",
    "arrow_up": "arrow-up",
