#!/usr/bin/env python3
"""Regenerate assets/themes/vscode/vscode.json from VS Code's default themes.

Usage: script/import-vscode-themes <path to microsoft/vscode checkout>

VS Code's theme files only hold the colors they change: each one includes a
base theme ("include"), and anything the chain leaves unset falls back to the
workbench defaults compiled into VS Code. crates/theme_importer reads a single
file and maps few UI colors, so this script:

1. resolves the include chain and fills in the workbench defaults,
2. runs theme_importer on the flattened theme for the syntax colors,
3. maps the workbench colors onto Zed's theme keys itself.

The themes are MIT licensed; see assets/themes/LICENSES.
"""

import json
import re
import subprocess
import sys
import tempfile
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
OUTPUT = REPO / "assets/themes/vscode/vscode.json"

THEMES = [
    ("Dark Modern", "dark_modern.json", "dark"),
    ("Light Modern", "light_modern.json", "light"),
    ("Dark+", "dark_plus.json", "dark"),
    ("Light+", "light_plus.json", "light"),
]

