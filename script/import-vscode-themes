    players = [
        {
            "cursor": get("editorCursor.foreground"),
            "background": get("editorCursor.foreground"),
            "selection": get("editor.selectionBackground"),
        }
    ]
    return result, players


# theme_importer matches some Zed tokens to HTML scopes (tag punctuation,
# HTML attributes) and leaves others unmatched. These are the colors the
# Dark+ and Light+ token rules (and their semantic token defaults) give the
# constructs Zed's tokens stand for.
SYNTAX_FIXES = {
    "dark": {
        "constant": "#4FC1FF",
        "constructor": "#4EC9B0",
        "enum": "#4EC9B0",
        "namespace": "#4EC9B0",
        "variant": "#4FC1FF",
        "property": "#9CDCFE",
        "variable.parameter": "#9CDCFE",
        "string.escape": "#D7BA7D",
        "string.regex": "#D16969",
        "preproc": "#C586C0",
        "title": "#569CD6",
        "link_text": "#CE9178",
        "link_uri": "#3794FF",
        "punctuation.markup": "#6796E6",
        "punctuation.list_marker": "#6796E6",
    },
    "light": {
        "constant": "#0070C1",
        "constructor": "#267F99",
        "enum": "#267F99",
        "namespace": "#267F99",
        "variant": "#0070C1",
        "property": "#001080",
        "variable.parameter": "#001080",
        "string.escape": "#EE0000",
        "string.regex": "#811F3F",
        "preproc": "#AF00DB",
        "title": "#800000",
        "link_text": "#A31515",
        "link_uri": "#006AB1",
        "punctuation.markup": "#0451A5",
        "punctuation.list_marker": "#0451A5",
    },
}


def fix_syntax(syntax, colors, appearance):
    editor_foreground = color({**WORKBENCH_DEFAULTS[appearance], **colors}.get("editor.foreground", WORKBENCH_DEFAULTS[appearance]["foreground"]))
    for token in ["punctuation", "punctuation.bracket", "punctuation.delimiter", "punctuation.special", "operator", "primary", "embedded"]:
        syntax[token] = {"color": editor_foreground}
    for token, value in SYNTAX_FIXES[appearance].items():
        syntax[token] = {"color": color(value)}
    syntax["title"]["font_weight"] = 700
    syntax["emphasis"] = {"font_style": "italic"}
    syntax["emphasis.strong"] = {"font_weight": 700}


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    themes_dir = Path(sys.argv[1]) / "extensions/theme-defaults/themes"
    family = {
        "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
        "name": "Vireo Default",
        "author": "Microsoft Corporation, ported to Vireo",
        "themes": [],
    }
    with tempfile.TemporaryDirectory() as scratch:
        for name, file_name, appearance in THEMES:
            flat = flatten(themes_dir / file_name)
            flat["name"] = name
            flat_path = Path(scratch) / file_name
            flat_path.write_text(json.dumps(flat))
            imported_path = Path(scratch) / f"imported-{file_name}"
            subprocess.run(
                ["cargo", "run", "--quiet", "-p", "theme_importer", "--", str(flat_path), "--output", str(imported_path)],
                cwd=REPO,
                check=True,
            )
            imported = json.loads(imported_path.read_text())
            style = imported["style"]
            colors, players = ui_colors(flat["colors"], appearance)
            # Keep the importer's status backgrounds and borders; replace the
            # UI colors it maps loosely (it reads only a handful of keys).
            style.update(colors)
            style["players"] = players
            fix_syntax(style["syntax"], flat["colors"], appearance)
            family["themes"].append({"name": name, "appearance": appearance, "style": style})
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    OUTPUT.write_text(json.dumps(family, indent=2) + "\n")
    print(f"wrote {OUTPUT.relative_to(REPO)}")


if __name__ == "__main__":
    main()
