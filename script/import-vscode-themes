def read_jsonc(path):
    """Parses JSON with comments and trailing commas, as VS Code writes it."""
    text = path.read_text()
    out = []
    index = 0
    in_string = False
    while index < len(text):
        char = text[index]
        if in_string:
            out.append(char)
            if char == "\\":
                out.append(text[index + 1])
                index += 1
            elif char == '"':
                in_string = False
        elif char == '"':
            in_string = True
            out.append(char)
        elif text.startswith("//", index):
            index = text.find("\n", index)
            if index == -1:
                break
            continue
        elif text.startswith("/*", index):
            index = text.find("*/", index) + 2
            continue
        else:
            out.append(char)
        index += 1
    return json.loads(re.sub(r",(\s*[}\]])", r"\1", "".join(out)))


def flatten(path):
    theme = read_jsonc(path)
    include = theme.get("include")
    if not include:
        return theme
    base = flatten((path.parent / include).resolve())
    return {
        "name": theme.get("name", base.get("name")),
        "colors": {**base.get("colors", {}), **theme.get("colors", {})},
        "tokenColors": base.get("tokenColors", []) + theme.get("tokenColors", []),
        "semanticTokenColors": {
            **base.get("semanticTokenColors", {}),
            **theme.get("semanticTokenColors", {}),
        },
    }


def color(value):
    """Normalizes #RGB, #RRGGBB and #RRGGBBAA to #rrggbbaa."""
    value = value.lower()
    if len(value) == 4:
        value = "#" + "".join(channel * 2 for channel in value[1:])
    if len(value) == 7:
        value += "ff"
    return value


def with_alpha(value, alpha):
    return color(value)[:7] + f"{round(alpha * 255):02x}"


def ui_colors(colors, appearance):
    c = {**WORKBENCH_DEFAULTS[appearance], **colors}

    def get(*keys):
        for key in keys:
            if key in c:
                return color(c[key])
        raise KeyError(keys)

    editor = get("editor.background")
    sidebar = get("sideBar.background")
    border = get("sideBar.border", "editorGroup.border")
    focus = get("focusBorder")
    terminal = {
        name: get(f"terminal.ansi{key}")
