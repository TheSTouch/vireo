        name: get(f"terminal.ansiBright{key}")
        for name, key in [
            ("black", "Black"), ("red", "Red"), ("green", "Green"), ("yellow", "Yellow"),
            ("blue", "Blue"), ("magenta", "Magenta"), ("cyan", "Cyan"), ("white", "White"),
        ]
    }
    scrollbar = get("scrollbarSlider.background")
    result = {
        "border": border,
        "border.variant": get("sideBarSectionHeader.border", "panel.border", "editorGroup.border"),
