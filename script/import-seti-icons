    "php": [".php", ".php4", ".php5", ".phtml", ".ctp"],
    "postcss": [".pcss", ".postcss"],
    "powershell": [".ps1", ".psm1", ".psd1", ".pssc", ".psrc"],
    "properties": [".properties", ".cfg", ".conf", ".directory", ".gitconfig", ".editorconfig", ".npmrc", ".ini"],
    "python": [".py", ".rpy", ".pyw", ".cpy", ".gyp", ".gypi", ".pyi", ".ipy", ".pyt"],
    "r": [".r", ".rhistory", ".rprofile", ".rt"],
    "razor": [".cshtml", ".razor"],
    "rescript": [".res", ".resi"],
    "ruby": [".rb", ".rbx", ".rjs", ".gemspec", ".rake", ".ru", ".podspec", ".rbi", "Gemfile", "Rakefile", "Podfile", "Guardfile", "Vagrantfile"],
    "rust": [".rs"],
    "sass": [".sass"],
    "scss": [".scss"],
    "shellscript": [".sh", ".bash", ".bashrc", ".bash_aliases", ".bash_profile", ".bash_login", ".ebuild", ".profile", ".bash_logout", ".xprofile", ".zsh", ".zshrc", ".zprofile", ".zlogin", ".zlogout", ".zshenv", ".zsh-theme", ".ksh", ".csh", ".cshrc", ".tcshrc", ".yashrc", ".yash_profile"],
    "sql": [".sql", ".dsql"],
    "stylus": [".styl"],
