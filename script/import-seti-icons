#!/usr/bin/env python3
"""Build Vireo's default file icon theme from VS Code's Seti icon theme.

Usage: script/import-seti-icons <microsoft/vscode checkout> <jesseweed/seti-ui checkout>

VS Code draws Seti icons from a font, coloring each glyph from
extensions/theme-seti/icons/vs-seti-icon-theme.json. seti-ui ships the same
glyphs as SVGs. This script writes one SVG per (glyph, color) pair into
assets/icons/color/seti, where the ui crate renders them in full color, and
writes the icon theme family Zed loads at startup.

Both are MIT licensed; see assets/icons/LICENSES.
"""

import json
import re
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
OUTPUT = REPO / "assets/icons/color/seti"
ASSET_PREFIX = "icons/color/seti"

# VS Code assigns many icons by language id; Zed matches file names only.
# These are the extensions and file names VS Code associates with each
# language id that the Seti theme uses.
LANGUAGE_FILES = {
    "argdown": [".ad", ".adown", ".argdown", ".argdn"],
    "bat": [".bat", ".cmd"],
    "bicep": [".bicep"],
    "blade": [".blade.php"],
    "c": [".c", ".h", ".i"],
    "clojure": [".clj", ".cljs", ".cljc", ".cljx", ".clojure", ".edn"],
    "coffeescript": [".coffee", ".cson", ".iced"],
    "cpp": [".cpp", ".cc", ".cxx", ".c++", ".hpp", ".hh", ".hxx", ".h++", ".ino", ".ipp", ".tpp", ".txx"],
    "csharp": [".cs", ".csx", ".cake"],
    "css": [".css"],
    "cuda-cpp": [".cu", ".cuh"],
    "dart": [".dart"],
    "dockercompose": ["compose.yml", "compose.yaml", "docker-compose.yml", "docker-compose.yaml"],
    "dockerfile": ["Dockerfile", "Containerfile", ".dockerfile", ".containerfile"],
    "dotenv": [".env"],
    "elixir": [".ex", ".exs"],
    "elm": [".elm"],
    "erb": [".erb", ".rhtml", ".html.erb"],
    "fsharp": [".fs", ".fsi", ".fsx", ".fsscript"],
    "git-commit": ["COMMIT_EDITMSG", "MERGE_MSG"],
    "go": [".go"],
    "godot": [".gd", ".tscn", ".tres", ".godot"],
    "gradle": [".gradle", ".gradle.kts"],
    "groovy": [".groovy", ".gvy", ".jenkinsfile", "Jenkinsfile"],
    "haml": [".haml"],
    "handlebars": [".handlebars", ".hbs", ".hjs"],
    "haskell": [".hs", ".lhs"],
    "haxe": [".hx"],
    "html": [".html", ".htm", ".shtml", ".xhtml", ".xht", ".mdoc", ".jshtm"],
    "ignore": [".gitignore", ".gitattributes", ".npmignore", ".dockerignore", ".eslintignore", ".prettierignore", ".git-blame-ignore-revs"],
    "jade": [".jade", ".pug"],
    "java": [".java", ".jav"],
    "javascript": [".js", ".es6", ".mjs", ".cjs", ".pac"],
    "javascriptreact": [".jsx"],
    "jinja": [".jinja", ".jinja2", ".j2"],
    "json": [".json", ".bowerrc", ".jscsrc", ".webmanifest", ".js.map", ".css.map", ".har", ".jslintrc", ".jsonld"],
    "jsonc": [".jsonc", ".eslintrc", ".eslintrc.json", ".jsfmtrc", ".jshintrc", ".swcrc", "tsconfig.json", "jsconfig.json"],
    "jsonl": [".jsonl", ".ndjson"],
    "julia": [".jl"],
    "kotlin": [".kt", ".kts"],
    "latex": [".latex", ".ltx", ".ctx"],
    "less": [".less"],
    "lua": [".lua"],
    "makefile": ["Makefile", "makefile", "GNUmakefile", "OCamlMakefile", ".mak", ".mk"],
    "markdown": [".md", ".mkd", ".mdwn", ".mdown", ".markdown", ".markdn", ".mdtxt", ".mdtext", ".workbook"],
    "mustache": [".mustache", ".mst", ".mu", ".stache"],
    "nunjucks": [".njk", ".nunjucks", ".nunjs", ".nunj"],
    "objective-c": [".m"],
    "objective-cpp": [".mm"],
