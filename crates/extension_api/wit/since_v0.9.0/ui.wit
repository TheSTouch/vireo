/// User interface APIs for Vireo addons.
///
/// Everything in this interface is new in v0.9.0 and is specific to Vireo.
interface ui {
    /// Shows an item on the right of the status bar, or updates the addon's item
    /// with the same ID.
    ///
    /// `command` is the ID of one of the addon's commands, run when the item is
    /// clicked.
    set-status-item: func(id: string, text: string, tooltip: option<string>, command: option<string>);

    /// Removes one of the addon's status bar items.
    remove-status-item: func(id: string);

    /// An item of a tree view.
    record tree-item {
        /// The item ID, unique within the view. Passed back as the parent when
        /// the item expands, and as the argument of commands run on the item.
        id: string,
        label: string,
        /// Shown dimmed after the label.
        description: option<string>,
        /// The name of a Vireo icon, such as `folder` or `file`.
        icon: option<string>,
        /// Whether the item has children and can expand.
        collapsible: bool,
        /// The ID of the addon command run, with the item ID as argument, when
        /// the item is clicked.
        command: option<string>,
        /// Matched against the `when` of the panel's context menu entries.
        context-value: option<string>,
    }

    /// Asks every place that shows the view to ask the addon for its content
    /// again: `tree-children` for tree views, `render-view` for custom views.
    refresh-view: func(view-id: string);

    /// The state of a text input.
    record text-input-state {
        value: string,
        placeholder: option<string>,
    }

    /// The state of a checkbox.
    record checkbox-state {
        label: string,
        checked: bool,
    }

    /// What an element of a custom view is.
    variant element-kind {
        /// Lays out its children vertically.
        column,
        /// Lays out its children horizontally.
        row,
        /// A column that scrolls vertically.
        scroll,
        /// A column of rows with list spacing.
        %list,
        label(string),
        /// The name of a Vireo icon, such as `folder`.
        icon(string),
        /// A button with this label. Clicking it sends `click`.
        button(string),
        /// A single-line text input. Editing it sends `change`; Enter sends `submit`.
        text-input(text-input-state),
        /// Toggling it sends `toggle`.
        checkbox(checkbox-state),
        divider,
    }

    /// An element of a custom view.
    record element {
        /// The element ID, unique within the view, passed back with its events.
        id: string,
        kind: element-kind,
        /// Indices of the element's children in `view-tree.elements`.
        children: list<u32>,
    }

    /// The content of a custom view. The first element is the root.
    record view-tree {
        elements: list<element>,
    }

    /// What happened to an element of a custom view.
    variant view-event {
        click,
        change(string),
        submit(string),
        toggle(bool),
    }

    /// Opens a custom view in an editor tab, or activates the tab showing it.
    open-view-tab: func(view-id: string, title: string);
}
